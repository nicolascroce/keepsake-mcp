{
  "name": "keepsake-mcp",
  "version": "1.10.0",
  "description": "MCP server for Keepsake personal CRM \u2014 connect your AI agent to your contacts, tasks, notes, and more",
  "type": "module",
  "bin": {
    "keepsake-mcp": "build/index.js"
  },
  "main": "./build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./tools": "./build/tools.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "keepsake",
    "crm",
    "ai-agent",
    "contacts",
    "tasks",
    "notes"
  ],
  "license": "MIT",
  "mcpName": "io.github.nicolascroce/keepsake",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
