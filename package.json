{
  "name": "keepsake-mcp",
  "version": "1.15.1",
  "description": "MCP server for Keepsake (keepsake.place), the app where creators and solo entrepreneurs empty their heads — connect your AI to your notes, tasks and contacts",
  "type": "module",
  "bin": {
    "keepsake-mcp": "build/index.js"
  },
  "main": "./build/index.js",
  "exports": {
    ".": "./build/index.js",
    "./tools": "./build/tools.js"
  },
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "dev": "tsc --watch"
  },
  "files": [
    "build"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "keepsake",
    "crm",
    "ai-agent",
    "contacts",
    "tasks",
    "notes"
  ],
  "license": "MIT",
  "mcpName": "io.github.nicolascroce/keepsake",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^7.0.2"
  }
}
